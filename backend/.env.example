# Copy to .env and fill in before starting the server.

# Prisma connection string. SQLite by default for local development.
DATABASE_URL="file:./dev.db"

# Signs parent session tokens. Use a long random value and keep it secret —
# anyone holding it can mint a valid login for any account.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

PORT=4000

# Optional. Comma-separated list of origins allowed to call the API from a
# browser. Leave unset in development so the Flutter web build can connect.
# CORS_ORIGIN="https://app.example.com"
